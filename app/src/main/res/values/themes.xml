<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.HuChiTieu" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1A237E</item>
    </style>

    <style name="Theme.HuChiTieu" parent="Base.Theme.HuChiTieu" />

    <!-- Style cho tiêu đề ngày trong lịch -->
    <style name="CalendarDayHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#9E9E9E</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Style mới giúp tiêu đề Bottom Nav in đậm -->
    <style name="BottomNavTextStyle">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
