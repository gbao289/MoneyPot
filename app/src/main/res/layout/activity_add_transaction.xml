<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    tools:context=".AddTransactionActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:navigationIcon="@drawable/ic_back_bold"
            app:title="Nhập Giao Dịch"
            app:titleTextColor="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Selector: Chi tiêu / Thu nhập (Dạng Tab hiện đại) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:checkedButton="@+id/btnExpense"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExpense"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="Chi tiêu"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/transaction_type_text_color"
                    app:backgroundTint="@color/transaction_type_background_color"
                    app:strokeColor="@color/black"
                    app:strokeWidth="2dp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIncome"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="Thu nhập"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/transaction_type_text_color"
                    app:backgroundTint="@color/transaction_type_background_color"
                    app:strokeColor="@color/black"
                    app:strokeWidth="2dp"
                    app:cornerRadius="16dp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Ô nhập Số tiền -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Số tiền (₫)"
                android:textColorHint="#000000"
                app:boxStrokeColor="#000000"
                app:boxStrokeWidth="2.5dp"
                app:boxStrokeWidthFocused="3dp"
                app:hintTextColor="#000000"
                app:startIconDrawable="@android:drawable/ic_menu_send"
                app:startIconTint="#000000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingVertical="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ô chọn Ngày giao dịch -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Ngày giao dịch"
                android:textColorHint="#000000"
                app:boxStrokeColor="#000000"
                app:boxStrokeWidth="2.5dp"
                app:boxStrokeWidthFocused="3dp"
                app:hintTextColor="#000000"
                app:startIconDrawable="@android:drawable/ic_menu_today"
                app:startIconTint="#000000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:inputType="none"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingVertical="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ô chọn Tần suất lặp lại (Dropdown) -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Tần suất lặp lại"
                android:textColorHint="#000000"
                app:boxStrokeColor="#000000"
                app:boxStrokeWidth="2.5dp"
                app:boxStrokeWidthFocused="3dp"
                app:hintTextColor="#000000"
                app:startIconDrawable="@android:drawable/ic_menu_recent_history"
                app:startIconTint="#000000">

                <AutoCompleteTextView
                    android:id="@+id/atvFrequency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingVertical="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ô chọn Nguồn tiền / Hũ (Dropdown) -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Nguồn tiền"
                android:textColorHint="#000000"
                app:boxStrokeColor="#000000"
                app:boxStrokeWidth="2.5dp"
                app:boxStrokeWidthFocused="3dp"
                app:hintTextColor="#000000"
                app:startIconDrawable="@android:drawable/ic_menu_manage"
                app:startIconTint="#000000">

                <AutoCompleteTextView
                    android:id="@+id/atvSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingVertical="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ô nhập Ghi chú -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Ghi chú"
                android:textColorHint="#000000"
                app:boxStrokeColor="#000000"
                app:boxStrokeWidth="2.5dp"
                app:boxStrokeWidthFocused="3dp"
                app:hintTextColor="#000000"
                app:startIconDrawable="@android:drawable/ic_menu_edit"
                app:startIconTint="#000000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingVertical="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Nút Lưu -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTransaction"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="40dp"
                android:text="LƯU GIAO DỊCH"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                app:cornerRadius="16dp"
                app:elevation="6dp"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
